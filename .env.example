# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Instrument & timeframe ────────────────────────────────────────────────────
INSTRUMENT=EURUSD
TIMEFRAME=M15

# ── Live vs mock ──────────────────────────────────────────────────────────────
# Set to true to use real MT5 terminal instead of mock data
LIVE_TRADING=false
MOCK_SCENARIO=bullish        # bullish | bearish | sideways | reversal_oversold | news_abort

# ── XM MT5 Credentials (only needed when LIVE_TRADING=true) ──────────────────
MT5_LOGIN=12345678           # Your XM account number (from XM dashboard)
MT5_PASSWORD=yourpassword    # Your XM MT5 password (NOT investor password)
MT5_SERVER=XM-Demo           # Server name — see list below

# Common XM Server names:
#   Demo accounts : XM-Demo
#   Real accounts : XM-Real, XM-Real 2, XM-Real 3, XM-Real 4, XM-Real 10, XM-Real 11
#   Check yours   : In MT5 → File → Open Account → search "XM"

# ── MT5 Symbol name ──────────────────────────────────────────────────────────
# Leave empty to use INSTRUMENT value above.
# XM Micro accounts use "m" suffix: EURUSDm, GBPUSDm
# XM Standard/Ultra Low use no suffix: EURUSD, GBPUSD
MT5_SYMBOL=

# ── Position sizing ───────────────────────────────────────────────────────────
MT5_LOT_SIZE=0.01            # 0.01 = micro lot (safest for testing)
MT5_MAGIC=20240001           # Unique ID — change if running multiple bots

# ── Risk rules ────────────────────────────────────────────────────────────────
STOP_LOSS_PIPS=10
TAKE_PROFIT_PIPS=20
BREAKEVEN_TRIGGER_PIPS=10
TRAILING_DISTANCE_PIPS=10

# ── Other settings ────────────────────────────────────────────────────────────
MAX_STRATEGY_RETRIES=3
POLL_INTERVAL_SECONDS=5
LOG_LEVEL=INFO
LOG_FILE=trading_system.log
